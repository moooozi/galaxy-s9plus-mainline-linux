--- /dev/null
+++ b/src/core/meta-touch-wakeup.h
@@ -0,0 +1,68 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Small, display-independent recognizer for opt-in touchscreen wake.
+ * Coordinates are in stage pixels; all wake contacts must be consumed.
+ */
+#pragma once
+#include <stdbool.h>
+#include <stdint.h>
+
+typedef struct {
+  unsigned contacts;
+  bool cancelled;
+  uint32_t down_time, tap_time;
+  float down_x, down_y, tap_x, tap_y;
+} MetaTouchWakeup;
+
+static inline bool
+meta_touch_wakeup_event (MetaTouchWakeup *state,
+                        int phase, /* 0 begin, 1 motion, 2 end, 3 cancel */
+                        uint32_t time, float x, float y)
+{
+  float dx, dy;
+  bool wake = false;
+
+  if (phase == 3)
+    {
+      *state = (MetaTouchWakeup) {0};
+      return false;
+    }
+  if (phase == 0)
+    {
+      if (state->contacts++ == 0)
+        {
+          state->cancelled = false;
+          state->down_time = time;
+          state->down_x = x;
+          state->down_y = y;
+        }
+      else
+        state->cancelled = true;
+      return false;
+    }
+  if (state->contacts == 0)
+    return false;
+
+  dx = x - state->down_x;
+  dy = y - state->down_y;
+  if (dx * dx + dy * dy > 40 * 40)
+    state->cancelled = true;
+  if (phase != 2)
+    return false;
+  if (--state->contacts != 0)
+    return false;
+
+  if (!state->cancelled && time - state->down_time <= 300)
+    {
+      dx = x - state->tap_x;
+      dy = y - state->tap_y;
+      wake = state->tap_time != 0 && time - state->tap_time <= 500 &&
+             dx * dx + dy * dy <= 60 * 60;
+      state->tap_time = wake ? 0 : time;
+      state->tap_x = x;
+      state->tap_y = y;
+    }
+  else
+    state->tap_time = 0;
+
+  return wake;
+}
