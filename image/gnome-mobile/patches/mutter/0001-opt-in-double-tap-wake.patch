+
+/* Consume sleeping-screen contacts before they can reset idle time or
+ * reach the unlock UI. The opt-in mapper keeps the touch device enabled. */
+static gboolean
+handle_touchscreen_wakeup (MetaDisplay *display, const ClutterEvent *event)
+{
+  MetaContext *context = meta_display_get_context (display);
+  MetaBackend *backend = meta_context_get_backend (context);
+  MetaMonitorManager *manager = meta_backend_get_monitor_manager (backend);
+  ClutterInputDevice *device = clutter_event_get_source_device (event);
+  ClutterEventType type = clutter_event_type (event);
+  gboolean sleeping = meta_monitor_manager_is_power_saving (manager);
+  float x, y;
+  int phase;
+
+  if (g_strcmp0 (g_getenv ("MUTTER_TOUCHSCREEN_WAKEUP"), "double-tap") != 0 ||
+      !device || clutter_input_device_get_device_type (device) != CLUTTER_TOUCHSCREEN_DEVICE)
+    return FALSE;
+
+  if (!sleeping && display->touch_wakeup.contacts == 0)
+    {
+      display->touch_wakeup = (MetaTouchWakeup) {0};
+      return FALSE;
+    }
+
+  switch (type)
+    {
+    case CLUTTER_TOUCH_BEGIN: phase = 0; break;
+    case CLUTTER_TOUCH_UPDATE: phase = 1; break;
+    case CLUTTER_TOUCH_END: phase = 2; break;
+    case CLUTTER_TOUCH_CANCEL: phase = 3; break;
+    default: return FALSE;
+    }
+  clutter_event_get_coords (event, &x, &y);
+  if (meta_touch_wakeup_event (&display->touch_wakeup, phase,
+                               clutter_event_get_time (event), x, y) && sleeping)
+    {
+      meta_idle_manager_reset_idle_time (meta_backend_get_idle_manager (backend));
+      meta_monitor_manager_set_power_save_mode (manager, META_POWER_SAVE_ON);
+    }
+  return TRUE;
 }
 
