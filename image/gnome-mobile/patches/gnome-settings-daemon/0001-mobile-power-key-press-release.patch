+/* The toggle-blank policy is the mobile power key: release blanks/wakes,
+ * while a one-second hold opens the session's confirmation dialog. */
+static void
+mobile_set_display_power_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+        g_autoptr(GError) error = NULL;
+        g_autoptr(GVariant) reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), result, &error);
+        if (!reply && !g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+                g_warning ("Cannot change display power: %s", error->message);
+}
+
+static void
+mobile_set_display_power (GsdMediaKeysManager *manager, gint mode)
+{
+        GsdMediaKeysManagerPrivate *priv = GSD_MEDIA_KEYS_MANAGER_GET_PRIVATE (manager);
+        g_dbus_connection_call (g_dbus_proxy_get_connection (G_DBUS_PROXY (priv->key_grabber)),
+                                "org.gnome.Mutter.DisplayConfig", "/org/gnome/Mutter/DisplayConfig",
+                                "org.freedesktop.DBus.Properties", "Set",
+                                g_variant_new ("(ssv)", "org.gnome.Mutter.DisplayConfig", "PowerSaveMode",
+                                               g_variant_new_int32 (mode)),
+                                NULL, G_DBUS_CALL_FLAGS_NONE, -1, priv->bus_cancellable,
+                                mobile_set_display_power_done, NULL);
+}
+
 static void
 do_toggle_blank (GsdMediaKeysManager *manager)
 {
-	GsdMediaKeysManagerPrivate *priv = GSD_MEDIA_KEYS_MANAGER_GET_PRIVATE (manager);
-
-        /* Activating the screen saver makes gsd-power turn the screen off right
-         * away. When the screen is already off, the button press itself counts as
-         * user activity, so gsd-power turns it back on and the screen saver stays
-         * as it is. */
+        GsdMediaKeysManagerPrivate *priv = GSD_MEDIA_KEYS_MANAGER_GET_PRIVATE (manager);
+
+        if (priv->mobile_power_was_off) {
+                mobile_set_display_power (manager, 0);
+                return;
+        }
+        if (priv->mobile_power_had_shield) {
+                mobile_set_display_power (manager, 3);
+                return;
+        }
         if (priv->screen_saver_proxy == NULL)
                 priv->screen_saver_proxy = gnome_settings_bus_get_screen_saver_proxy ();
 
+        /* Let the first activation finish its lock animation before GSD Power
+         * blanks via ActiveChanged; do not stop the display before locking. */
         gsd_screen_saver_call_set_active (priv->screen_saver_proxy, TRUE, NULL,
                                           toggle_blank_cb, NULL);
+}
+
+static gboolean
+mobile_power_long_press (gpointer data)
+{
+        GsdMediaKeysManager *manager = data;
+        GsdMediaKeysManagerPrivate *priv = GSD_MEDIA_KEYS_MANAGER_GET_PRIVATE (manager);
+        priv->mobile_power_timer = 0;
+        priv->mobile_power_action = 0;
+        mobile_set_display_power (manager, 0);
+        /* Request the existing confirmation UI, including when locked.
+         * Never call logind's immediate PowerOff action here. */
+        gnome_session_shutdown (manager);
+        return G_SOURCE_REMOVE;
+}
+
+static void
+mobile_power_cancel (GsdMediaKeysManager *manager)
+{
+        GsdMediaKeysManagerPrivate *priv = GSD_MEDIA_KEYS_MANAGER_GET_PRIVATE (manager);
+        g_clear_handle_id (&priv->mobile_power_timer, g_source_remove);
+        priv->mobile_power_action = 0;
+}
+
+static void
+on_accelerator_deactivated (ShellKeyGrabber *grabber,
+                            guint action,
+                            GVariant *parameters,
+                            GsdMediaKeysManager *manager)
+{
+        GsdMediaKeysManagerPrivate *priv = GSD_MEDIA_KEYS_MANAGER_GET_PRIVATE (manager);
+        if (action != priv->mobile_power_action)
+                return;
+        if (priv->mobile_power_timer != 0 && !priv->power_button_disabled)
+                do_toggle_blank (manager);
+        mobile_power_cancel (manager);
 }
 
